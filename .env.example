# Copy to .env.local (local) and add the same names in Vercel > Settings > Environment Variables.

# 1) Email — Gmail SMTP with an App Password (https://myaccount.google.com/apppasswords)
SMTP_USER=arenafinserv@gmail.com
SMTP_PASS=
ENQUIRY_EMAIL_TO=arenafinserv@gmail.com

# 2) Google Sheet — Apps Script web app URL (see docs/SETUP-APPLICATIONS.md)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# 3) WhatsApp Business Cloud API (see docs/SETUP-APPLICATIONS.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=919972718696
WHATSAPP_TEMPLATE=new_enquiry
WHATSAPP_TEMPLATE_LANG=en

# Public site URL, used for Open Graph/Twitter image URLs, the sitemap and structured data.
# Set this on Vercel to the live domain, e.g. https://www.arenafinance.in
NEXT_PUBLIC_SITE_URL=https://www.arenafinance.in
